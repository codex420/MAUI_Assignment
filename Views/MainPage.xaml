<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_Assignment.Models"
             xmlns:components="clr-namespace:MAUI_Assignment.Components"
             xmlns:vm="clr-namespace:MAUI_Assignment.ViewModels"
             x:Class="MAUI_Assignment.Views.MainPage"
             x:DataType="vm:DashboardViewModel"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid ColumnDefinitions="Auto,*">

        <!-- Sidebar -->
        <components:SidebarView Grid.Column="0" BindingContext="{Binding .}" />

        <!-- Main content -->
        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- Row 1: Header summary + Traffic -->
                <Grid ColumnDefinitions="2.4*,1*" ColumnSpacing="18">
                    <components:HeaderView Grid.Column="0" BindingContext="{Binding .}" />
                    <components:TrafficView Grid.Column="1" BindingContext="{Binding .}" />
                </Grid>

                <!-- Row 2: Stat cards -->
                <CollectionView ItemsSource="{Binding StatCards}" SelectionMode="None" HeightRequest="120">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="4"
                                         HorizontalItemSpacing="18" VerticalItemSpacing="0" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:StatCard">
                            <components:CardView BindingContext="{Binding .}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Row 3: Recent Activities + Order Status -->
                <Grid ColumnDefinitions="1*,1.9*" ColumnSpacing="18">
                    <components:RecentActivitiesView Grid.Column="0" BindingContext="{Binding .}" VerticalOptions="Start" />
                    <components:OrderStatusView Grid.Column="1" BindingContext="{Binding .}" VerticalOptions="Start" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
