<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_Assignment.Models"
             xmlns:components="clr-namespace:MAUI_Assignment.Components"
             xmlns:vm="clr-namespace:MAUI_Assignment.ViewModels"
             x:Class="MAUI_Assignment.Views.MainPage"
             x:Name="Page"
             x:DataType="vm:DashboardViewModel"
             BackgroundColor="{StaticResource PageBackground}">

    <!-- Single-cell root: sidebar overlays/docks on top of the content layer. -->
    <Grid x:Name="RootGrid" ColumnDefinitions="Auto,*">

        <!-- ============ Docked sidebar (wide / medium) ============ -->
        <!-- Occupies layout space only when NOT in overlay mode and open. -->
        <components:SidebarView Grid.Column="0"
                                BindingContext="{Binding .}"
                                IsVisible="{Binding DockedSidebarVisible}"
                                WidthRequest="230" />

        <!-- ============ Main content ============ -->
        <Grid Grid.Column="1" RowDefinitions="*">

            <!-- Scrollable dashboard body (top app bar removed to match design) -->
            <ScrollView Grid.Row="0" IsVisible="{Binding IsDashboardActive}">
                <VerticalStackLayout Padding="{Binding ContentPadding}" Spacing="10">

                    <!-- Row 1: Header summary + Traffic (reflows) -->
                    <Grid ColumnDefinitions="63*, 37*"
                          RowDefinitions="Auto, Auto"
                          ColumnSpacing="10"
                          RowSpacing="10">
                        <components:HeaderView BindingContext="{Binding .}"
                                               Grid.Row="{Binding HeaderRow}"
                                               Grid.Column="{Binding HeaderColumn}"
                                               Grid.ColumnSpan="{Binding HeaderColumnSpan}" />
                        <components:TrafficView BindingContext="{Binding .}"
                                                Grid.Row="{Binding TrafficRow}"
                                                Grid.Column="{Binding TrafficColumn}"
                                                Grid.ColumnSpan="{Binding TrafficColumnSpan}" />
                    </Grid>

                    <!-- Row 2: Stat cards (reflow 4 / 2 / 1 across).
                         FlexLayout + BindableLayout so the row measures inside
                         the ScrollView on Android; basis comes from the VM. -->
                    <FlexLayout Wrap="Wrap" Direction="Row"
                                AlignItems="Stretch" JustifyContent="Start"
                                Margin="0,0,-16,-16"
                                BindableLayout.ItemsSource="{Binding StatCards}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:StatCard">
                                <components:CardView BindingContext="{Binding .}"
                                                     HeightRequest="118"
                                                     Margin="0,0,10,10"
                                                     FlexLayout.Grow="1"
                                                     FlexLayout.Basis="{Binding Source={x:Reference Page}, Path=BindingContext.StatCardBasis}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>


                    <!-- Row 3: Recent Activities + Order Status (reflows) -->
                    <Grid ColumnDefinitions="35*, 65*"
                          RowDefinitions="Auto, Auto"
                          ColumnSpacing="18"
                          RowSpacing="18">
                        <components:RecentActivitiesView BindingContext="{Binding .}"
                                                         Grid.Row="{Binding ActivitiesRow}"
                                                         Grid.Column="{Binding ActivitiesColumn}"
                                                         Grid.ColumnSpan="{Binding ActivitiesColumnSpan}" />
                        <components:OrderStatusView BindingContext="{Binding .}"
                                                    Grid.Row="{Binding OrdersRow}"
                                                    Grid.Column="{Binding OrdersColumn}"
                                                    Grid.ColumnSpan="{Binding OrdersColumnSpan}" />
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Compact-only floating menu button (Android / narrow screens).
                 Wide & medium layouts keep the sidebar permanently docked, so no
                 button is shown there. -->
            <Border Grid.Row="0"
                    IsVisible="{Binding SidebarIsOverlay}"
                    WidthRequest="40" HeightRequest="40"
                    Margin="12,12,0,0"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource CardBackground}"
                    HorizontalOptions="Start" VerticalOptions="Start"
                    ZIndex="5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label Text="&#x2630;" FontSize="18"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleSidebarCommand}" />
                </Border.GestureRecognizers>
            </Border>

            <!-- WebView container for non-dashboard tabs -->
            <Grid Grid.Row="0" IsVisible="{Binding IsDashboardActive, Converter={StaticResource InvertBoolConverter}}">
                <WebView Source="{Binding CurrentUrl}"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill" />
            </Grid>
        </Grid>

        <!-- ============ Scrim (compact overlay only) ============ -->
        <BoxView Grid.ColumnSpan="2"
                 Color="#66000000"
                 IsVisible="{Binding ScrimVisible}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseSidebarCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- ============ Overlay sidebar (compact only) ============ -->
        <components:SidebarView Grid.ColumnSpan="2"
                               BindingContext="{Binding .}"
                               WidthRequest="250"
                               HorizontalOptions="Start"
                               IsVisible="{Binding ScrimVisible}" />

        <!-- ============ Add Order Modal Dialog ============ -->
        <Grid Grid.ColumnSpan="2"
              IsVisible="{Binding IsAddOrderModalVisible}"
              BackgroundColor="#aa000000"
              HorizontalOptions="Fill" VerticalOptions="Fill">
            
            <Border VerticalOptions="Center" HorizontalOptions="Center"
                    WidthRequest="400" Padding="24"
                    BackgroundColor="{StaticResource CardBackground}"
                    StrokeThickness="1" Stroke="{StaticResource BorderColor}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                
                <VerticalStackLayout Spacing="16">
                    <Label Text="{Binding ModalTitle}" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource TextPrimary}" />
                    
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Customer Name" Style="{StaticResource Caption}" />
                        <Border StrokeThickness="1" Stroke="{StaticResource BorderColor}" BackgroundColor="White" Padding="10,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            <Entry Text="{Binding NewOrderCustomer}" Placeholder="e.g. John Doe" TextColor="Black" BackgroundColor="Transparent" HeightRequest="38" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="From (Country)" Style="{StaticResource Caption}" />
                        <Border StrokeThickness="1" Stroke="{StaticResource BorderColor}" BackgroundColor="White" Padding="10,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            <Entry Text="{Binding NewOrderFrom}" Placeholder="e.g. Germany" TextColor="Black" BackgroundColor="Transparent" HeightRequest="38" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Price" Style="{StaticResource Caption}" />
                        <Border StrokeThickness="1" Stroke="{StaticResource BorderColor}" BackgroundColor="White" Padding="10,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            <Entry Text="{Binding NewOrderPrice}" Placeholder="e.g. 250" Keyboard="Numeric" TextColor="Black" BackgroundColor="Transparent" HeightRequest="38" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Status" Style="{StaticResource Caption}" />
                        <Border StrokeThickness="1" Stroke="{StaticResource BorderColor}" BackgroundColor="White" Padding="10,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            <Picker SelectedItem="{Binding NewOrderStatus}" TextColor="Black" BackgroundColor="Transparent" HeightRequest="38">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Process</x:String>
                                        <x:String>Open</x:String>
                                        <x:String>On Hold</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="Cancel"
                                Style="{StaticResource AccentButton}"
                                BackgroundColor="{StaticResource PageBackground}"
                                TextColor="{StaticResource TextSecondary}"
                                Command="{Binding CloseAddOrderModalCommand}" />
                        
                        <Button Grid.Column="1" Text="Submit"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding SubmitNewOrderCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ============ Info Modal Dialog ============ -->
        <Grid Grid.ColumnSpan="2"
              IsVisible="{Binding IsInfoModalVisible}"
              BackgroundColor="#aa000000"
              HorizontalOptions="Fill" VerticalOptions="Fill">
            
            <Border VerticalOptions="Center" HorizontalOptions="Center"
                    WidthRequest="350" Padding="24"
                    BackgroundColor="{StaticResource CardBackground}"
                    StrokeThickness="1" Stroke="{StaticResource BorderColor}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                
                <VerticalStackLayout Spacing="16">
                    <Label Text="Information" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource TextPrimary}" />
                    
                    <Label Text="{Binding InfoModalMessage}" FontSize="14" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                    
                    <Button Text="Close"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding CloseInfoModalCommand}"
                            Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ============ Summary Modal Dialog ============ -->
        <Grid Grid.ColumnSpan="2"
              IsVisible="{Binding IsSummaryModalVisible}"
              BackgroundColor="#aa000000"
              HorizontalOptions="Fill" VerticalOptions="Fill">
            
            <Border VerticalOptions="Center" HorizontalOptions="Center"
                    WidthRequest="400" Padding="24"
                    BackgroundColor="{StaticResource CardBackground}"
                    StrokeThickness="1" Stroke="{StaticResource BorderColor}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                
                <VerticalStackLayout Spacing="16">
                    <Label Text="Last Month Summary" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource TextPrimary}" />
                    
                    <Label Text="{Binding SummaryModalDetails}" FontSize="14" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                    
                    <Button Text="Close"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding CloseSummaryModalCommand}"
                            Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
