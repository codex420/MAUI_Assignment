<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_Assignment.Models"
             xmlns:components="clr-namespace:MAUI_Assignment.Components"
             xmlns:vm="clr-namespace:MAUI_Assignment.ViewModels"
             x:Class="MAUI_Assignment.Views.MainPage"
             x:Name="Page"
             x:DataType="vm:DashboardViewModel"
             BackgroundColor="{StaticResource PageBackground}">

    <!-- Single-cell root: sidebar overlays/docks on top of the content layer. -->
    <Grid x:Name="RootGrid" ColumnDefinitions="Auto,*">

        <!-- ============ Docked sidebar (wide / medium) ============ -->
        <!-- Occupies layout space only when NOT in overlay mode and open. -->
        <components:SidebarView Grid.Column="0"
                                BindingContext="{Binding .}"
                                IsVisible="{Binding DockedSidebarVisible}"
                                WidthRequest="230" />

        <!-- ============ Main content ============ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Top app bar with hamburger toggle -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto"
                  Padding="12,10" ColumnSpacing="10"
                  BackgroundColor="{StaticResource CardBackground}">
                <Border Grid.Column="0"
                        WidthRequest="42" HeightRequest="42"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource PageBackground}"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Label Text="&#x2630;" FontSize="20"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleSidebarCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Label Grid.Column="1" Text="{Binding PageHeaderTitle}"
                       Style="{StaticResource SectionTitle}"
                       VerticalOptions="Center" />

                <Border Grid.Column="2"
                        WidthRequest="38" HeightRequest="38"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource Accent}"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19" />
                    </Border.StrokeShape>
                    <Label Text="A" TextColor="{StaticResource White}"
                           FontFamily="OpenSansSemibold"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Scrollable dashboard body -->
            <ScrollView Grid.Row="1" IsVisible="{Binding IsDashboardActive}">
                <VerticalStackLayout Padding="{Binding ContentPadding}" Spacing="18">

                    <!-- Row 1: Header summary + Traffic (reflows) -->
                    <FlexLayout Wrap="Wrap" Direction="Row"
                                AlignItems="Stretch" JustifyContent="Start">
                        <components:HeaderView BindingContext="{Binding .}"
                                               FlexLayout.Grow="1" FlexLayout.Shrink="1"
                                               FlexLayout.Basis="{Binding TopRowVertical, Converter={StaticResource StackedToBasisConverter}, ConverterParameter=63%}" />
                        <components:TrafficView BindingContext="{Binding .}"
                                                Margin="{Binding TopRowVertical, Converter={StaticResource RowGapConverter}}"
                                                FlexLayout.Grow="1" FlexLayout.Shrink="1"
                                                FlexLayout.Basis="{Binding TopRowVertical, Converter={StaticResource StackedToBasisConverter}, ConverterParameter=33%}" />
                    </FlexLayout>

                    <!-- Row 2: Stat cards (reflow 4 / 2 / 1 across).
                         FlexLayout + BindableLayout so the row measures inside
                         the ScrollView on Android; basis comes from the VM. -->
                    <FlexLayout Wrap="Wrap" Direction="Row"
                                AlignItems="Stretch" JustifyContent="Start"
                                Margin="0,0,-16,-16"
                                BindableLayout.ItemsSource="{Binding StatCards}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:StatCard">
                                <components:CardView BindingContext="{Binding .}"
                                                     HeightRequest="110"
                                                     Margin="0,0,16,16"
                                                     FlexLayout.Grow="1"
                                                     FlexLayout.Basis="{Binding Source={x:Reference Page}, Path=BindingContext.StatCardBasis}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>


                    <!-- Row 3: Recent Activities + Order Status (reflows) -->
                    <FlexLayout Wrap="Wrap" Direction="Row"
                                AlignItems="Stretch" JustifyContent="Start">
                        <components:RecentActivitiesView BindingContext="{Binding .}"
                                                         FlexLayout.Grow="1" FlexLayout.Shrink="1"
                                                         FlexLayout.Basis="{Binding BottomRowVertical, Converter={StaticResource StackedToBasisConverter}, ConverterParameter=33%}" />
                        <components:OrderStatusView BindingContext="{Binding .}"
                                                    Margin="{Binding BottomRowVertical, Converter={StaticResource RowGapConverter}}"
                                                    FlexLayout.Grow="1" FlexLayout.Shrink="1"
                                                    FlexLayout.Basis="{Binding BottomRowVertical, Converter={StaticResource StackedToBasisConverter}, ConverterParameter=63%}" />
                    </FlexLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- WebView container for non-dashboard tabs -->
            <Grid Grid.Row="1" IsVisible="{Binding IsDashboardActive, Converter={StaticResource InvertBoolConverter}}">
                <WebView Source="{Binding CurrentUrl}"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill" />
            </Grid>
        </Grid>

        <!-- ============ Scrim (compact overlay only) ============ -->
        <BoxView Grid.ColumnSpan="2"
                 Color="#66000000"
                 IsVisible="{Binding ScrimVisible}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseSidebarCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- ============ Overlay sidebar (compact only) ============ -->
        <components:SidebarView Grid.ColumnSpan="2"
                               BindingContext="{Binding .}"
                               WidthRequest="250"
                               HorizontalOptions="Start"
                               IsVisible="{Binding ScrimVisible}" />

    </Grid>

</ContentPage>
