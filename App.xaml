<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:MAUI_Assignment.Services"
             x:Class="MAUI_Assignment.App">
    <Application.Resources>
        <ResourceDictionary>
            <services:NotEmptyConverter x:Key="NotEmptyConverter" />
            <services:BoolToOrientationConverter x:Key="BoolToOrientationConverter" />
            <services:InvertBoolConverter x:Key="InvertBoolConverter" />
            <services:EnumEqualsConverter x:Key="EnumEqualsConverter" />
            <services:StackedToBasisConverter x:Key="StackedToBasisConverter" />
            <services:RowGapConverter x:Key="RowGapConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
