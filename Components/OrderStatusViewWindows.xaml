<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_Assignment.Models"
             xmlns:vm="clr-namespace:MAUI_Assignment.ViewModels"
             xmlns:components="clr-namespace:MAUI_Assignment.Components"
             x:Class="MAUI_Assignment.Components.OrderStatusViewWindows"
             x:DataType="vm:DashboardViewModel"
             x:Name="Root">

    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="10">

            <!-- Header -->
            <VerticalStackLayout Spacing="1">
                <Label Text="Order Status" Style="{StaticResource SectionTitle}" />
                <Label Text="Overview of Latest Month" Style="{StaticResource SectionSubtitle}" />
            </VerticalStackLayout>

            <!-- Toolbar -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Text="&#x2295; Add" Style="{StaticResource AccentButton}" HeightRequest="34" Padding="12,4" FontSize="12" Command="{Binding ShowAddOrderModalCommand}" />

<!-- Native Buttons instead of TapGestureRecognizer Borders: on Windows the
                     scroll host can swallow tap gestures, but a WinUI Button always gets the click. -->
                <Button Grid.Column="1" Text="&#x24D8;" FontSize="14" TextColor="{StaticResource TextPrimary}"
                        WidthRequest="34" HeightRequest="34" Padding="0" BorderWidth="0" CornerRadius="6"
                        BackgroundColor="{StaticResource PageBackground}"
                        Command="{Binding ShowInfoCommand}" />

                <Button Grid.Column="2" Text="&#x1F5D1;" FontSize="14" TextColor="{StaticResource TextPrimary}"
                        WidthRequest="34" HeightRequest="34" Padding="0" BorderWidth="0" CornerRadius="6"
                        BackgroundColor="{StaticResource PageBackground}"
                        Command="{Binding DeleteSelectedOrdersCommand}" />

                <Button Grid.Column="3" Text="&#x1F5A8;" FontSize="14" TextColor="{StaticResource TextPrimary}"
                        WidthRequest="34" HeightRequest="34" Padding="0" BorderWidth="0" CornerRadius="6"
                        BackgroundColor="{StaticResource PageBackground}"
                        Command="{Binding PrintOrdersCommand}" />

                <BoxView Grid.Column="4" Color="Transparent" />

                <Border Grid.Column="5" WidthRequest="150" HeightRequest="34" StrokeThickness="0" BackgroundColor="{StaticResource PageBackground}" Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                    <Entry Text="{Binding SearchQuery}" Placeholder="Search" PlaceholderColor="{StaticResource TextSecondary}" FontSize="12" VerticalOptions="Center" BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}" Margin="10,0" />
                </Border>

                <Border Grid.Column="6" WidthRequest="34" HeightRequest="34" StrokeThickness="0" BackgroundColor="{StaticResource PageBackground}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                    <Label Text="&#x1F50D;" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource TextPrimary}" />
                </Border>
            </Grid>

            <!-- Table header -->
            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="1.1*,1.5*,1.1*,1*,1.6*" Padding="12,8" ColumnSpacing="8" BackgroundColor="#EEF2F6">
                    <Label Grid.Column="0" Text="INVOICE" Style="{StaticResource TableHeader}" TextColor="{StaticResource TextPrimary}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="CUSTOMERS" Style="{StaticResource TableHeader}" TextColor="{StaticResource TextPrimary}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="FROM" Style="{StaticResource TableHeader}" TextColor="{StaticResource TextPrimary}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="PRICE" Style="{StaticResource TableHeader}" TextColor="{StaticResource TextPrimary}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                    <Label Grid.Column="4" Text="STATUS" Style="{StaticResource TableHeader}" TextColor="{StaticResource TextPrimary}" FontFamily="OpenSansSemibold" HorizontalOptions="Start" VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" HorizontalOptions="Fill" />
            </VerticalStackLayout>

            <!-- Rows. WINDOWS-SPECIFIC: each row hosts a chrome-less native Button
                 (see template) because a TapGestureRecognizer on the Grid does not
                 fire here — the scroll host swallows it. Highlight comes from
                 RowBackground on the model. -->
            <VerticalStackLayout Spacing="0"
                                 BindableLayout.ItemsSource="{Binding Orders}"
                                 Margin="0,0,0,8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:OrderItem">
                        <VerticalStackLayout Spacing="0">
                            <Grid HeightRequest="44" BackgroundColor="{Binding RowBackground}">

                                <!-- Full-row, chrome-less native Button: a WinUI Button is always
                                     hit-testable inside the scroll host, so a mouse click anywhere
                                     on the row reliably toggles selection. The visible cells above
                                     it are InputTransparent so clicks fall through to the Button. -->
                                <Button BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        CornerRadius="0"
                                        Padding="0"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        Command="{Binding BindingContext.ToggleOrderSelectionCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding .}" />

                                <Grid ColumnDefinitions="1.1*,1.5*,1.1*,1*,1.6*" Padding="12,0" ColumnSpacing="8"
                                      InputTransparent="True" CascadeInputTransparent="True">
                                    <Label Grid.Column="0" Text="{Binding Invoice}" Style="{StaticResource TableCell}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Customer}" Style="{StaticResource TableCell}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding From}" Style="{StaticResource TableCell}" VerticalOptions="Center" />
                                    <Label Grid.Column="3" Text="{Binding Price}" Style="{StaticResource TableCell}" VerticalOptions="Center" />
                                    <Border Grid.Column="4" HorizontalOptions="Start" VerticalOptions="Center"
                                            StrokeThickness="0" BackgroundColor="{Binding StatusColor}"
                                            Padding="10,4">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="5" /></Border.StrokeShape>
                                        <Label Text="{Binding Status}" FontSize="11"
                                               FontFamily="OpenSansSemibold"
                                               LineBreakMode="NoWrap"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{StaticResource White}" />
                                    </Border>
                                </Grid>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" HorizontalOptions="Fill" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Footer / pagination -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <Label Grid.Column="0" Text="{Binding PaginationStatusText}"
                       Style="{StaticResource Caption}" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Label Text="&#x2039;" FontSize="20" VerticalOptions="Center" Padding="6" HorizontalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PreviousPageCommand}" />
                        </Label.GestureRecognizers>
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding CanGoPrevious}" Value="False">
                                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding CanGoPrevious}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <HorizontalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding PageNumbers}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="{x:Null}">
                                <Grid WidthRequest="28" HeightRequest="28">
                                    <Border WidthRequest="26" HeightRequest="26" StrokeThickness="0" BackgroundColor="#EAF4FE" VerticalOptions="Center" HorizontalOptions="Center" IsVisible="False">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                                        <Label Text="{Binding .}" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#3F8CFF" HorizontalOptions="Center" VerticalOptions="Center" />
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding BindingContext.CurrentPage, Source={RelativeSource AncestorType={x:Type components:OrderStatusViewWindows}}}" Value="{Binding .}">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>

                                    <Label Text="{Binding .}" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" HorizontalOptions="Center" Padding="4" IsVisible="True">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.ChangePageCommand, Source={RelativeSource AncestorType={x:Type components:OrderStatusViewWindows}}}" CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding BindingContext.CurrentPage, Source={RelativeSource AncestorType={x:Type components:OrderStatusViewWindows}}}" Value="{Binding .}">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <Label Text="&#x203A;" FontSize="20" VerticalOptions="Center" Padding="6" HorizontalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NextPageCommand}" />
                        </Label.GestureRecognizers>
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding CanGoNext}" Value="False">
                                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding CanGoNext}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </Border>

</ContentView>
