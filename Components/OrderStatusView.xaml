<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_Assignment.Models"
             xmlns:vm="clr-namespace:MAUI_Assignment.ViewModels"
             x:Class="MAUI_Assignment.Components.OrderStatusView"
             x:DataType="vm:DashboardViewModel">

    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="16">

            <!-- Header -->
            <VerticalStackLayout Spacing="2">
                <Label Text="Order Status" Style="{StaticResource SectionTitle}" />
                <Label Text="Overview of Latest Month" Style="{StaticResource SectionSubtitle}" />
            </VerticalStackLayout>

            <!-- Toolbar -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Text="+ Add" Style="{StaticResource AccentButton}" HeightRequest="34" Padding="12,4" FontSize="12" Command="{Binding ShowAddOrderModalCommand}" />
                <Border Grid.Column="1" WidthRequest="34" HeightRequest="34" StrokeThickness="1" Stroke="{StaticResource BorderColor}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                    <Label Text="&#x2139;" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                </Border>
                <Border Grid.Column="2" WidthRequest="34" HeightRequest="34" StrokeThickness="1" Stroke="{StaticResource BorderColor}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                    <Label Text="&#x1F5D1;" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                </Border>
                <Border Grid.Column="3" WidthRequest="34" HeightRequest="34" StrokeThickness="1" Stroke="{StaticResource BorderColor}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                    <Label Text="&#x1F5A8;" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                </Border>

                <Border Grid.Column="5" WidthRequest="150" HeightRequest="34" StrokeThickness="1" Stroke="{StaticResource BorderColor}" Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                    <Entry Text="{Binding SearchQuery}" Placeholder="Search..." FontSize="12" VerticalOptions="Center" BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}" Margin="10,0" />
                </Border>
                <Border Grid.Column="6" WidthRequest="34" HeightRequest="34" StrokeThickness="1" Stroke="{StaticResource BorderColor}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                    <Label Text="&#x1F50D;" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                </Border>
            </Grid>

            <!-- Table header -->
            <Grid ColumnDefinitions="1.1*,1.6*,1.2*,1*,1.2*" Padding="0,10" ColumnSpacing="8">
                <BoxView Grid.ColumnSpan="5" Color="{StaticResource BorderColor}" HeightRequest="1" VerticalOptions="Start" />
                <Label Grid.Column="0" Text="INVOICE" Style="{StaticResource TableHeader}" />
                <Label Grid.Column="1" Text="CUSTOMERS" Style="{StaticResource TableHeader}" />
                <Label Grid.Column="2" Text="FROM" Style="{StaticResource TableHeader}" />
                <Label Grid.Column="3" Text="PRICE" Style="{StaticResource TableHeader}" />
                <Label Grid.Column="4" Text="STATUS" Style="{StaticResource TableHeader}" HorizontalOptions="Center" />
                <BoxView Grid.ColumnSpan="5" Color="{StaticResource BorderColor}" HeightRequest="1" VerticalOptions="End" />
            </Grid>

            <!-- Rows: BindableLayout so the table sizes naturally inside the
                 page's ScrollView (nested CollectionView mis-measures on Android). -->
            <VerticalStackLayout Spacing="0"
                                 BindableLayout.ItemsSource="{Binding Orders}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:OrderItem">
                        <Grid ColumnDefinitions="1.1*,1.6*,1.2*,1*,1.2*" Padding="0,12" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{Binding Invoice}" Style="{StaticResource TableCell}" />
                            <Label Grid.Column="1" Text="{Binding Customer}" Style="{StaticResource TableCell}" />
                            <Label Grid.Column="2" Text="{Binding From}" Style="{StaticResource TableCell}" />
                            <Label Grid.Column="3" Text="{Binding Price}" Style="{StaticResource TableCell}" />
                            <Border Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center"
                                    StrokeThickness="0" BackgroundColor="{Binding StatusColor}"
                                    Padding="14,5">
                                <Border.StrokeShape><RoundRectangle CornerRadius="5" /></Border.StrokeShape>
                                <Label Text="{Binding Status}" FontSize="11"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource White}" />
                            </Border>
                            <BoxView Grid.ColumnSpan="5" Color="{StaticResource BorderColor}" HeightRequest="1" VerticalOptions="End" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Footer / pagination -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding PaginationStatusText}"
                       Style="{StaticResource Caption}" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                    <!-- Previous Arrow -->
                    <Label Text="&#x2039;" FontSize="22" VerticalOptions="Center" Padding="4" HorizontalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PreviousPageCommand}" />
                        </Label.GestureRecognizers>
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding CanGoPrevious}" Value="False">
                                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding CanGoPrevious}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <!-- Page Info -->
                    <Label Text="{Binding PageIndicatorText}" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />

                    <!-- Next Arrow -->
                    <Label Text="&#x203A;" FontSize="22" VerticalOptions="Center" Padding="4" HorizontalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NextPageCommand}" />
                        </Label.GestureRecognizers>
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding CanGoNext}" Value="False">
                                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding CanGoNext}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </Border>

</ContentView>
