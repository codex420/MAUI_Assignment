<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_Assignment.Models"
             xmlns:components="clr-namespace:MAUI_Assignment.Components"
             xmlns:vm="clr-namespace:MAUI_Assignment.ViewModels"
             x:Class="MAUI_Assignment.Components.RecentActivitiesView"
             x:DataType="vm:DashboardViewModel">

    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="6">
            <Label Text="Recent Activities" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <!-- BindableLayout (not CollectionView) so the list measures its
                 natural height inside the outer ScrollView on Android. -->
            <VerticalStackLayout Spacing="0"
                                 BindableLayout.ItemsSource="{Binding RecentActivities}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ActivityItem">
                        <components:ListItemView BindingContext="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>

</ContentView>
