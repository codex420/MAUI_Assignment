<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_Assignment.Models"
             xmlns:components="clr-namespace:MAUI_Assignment.Components"
             xmlns:vm="clr-namespace:MAUI_Assignment.ViewModels"
             x:Class="MAUI_Assignment.Components.RecentActivitiesView"
             x:DataType="vm:DashboardViewModel">

    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="6">
            <Label Text="Recent Activities" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <CollectionView ItemsSource="{Binding RecentActivities}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ActivityItem">
                        <components:ListItemView BindingContext="{Binding .}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Border>

</ContentView>
