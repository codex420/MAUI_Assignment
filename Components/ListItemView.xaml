<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_Assignment.Models"
             x:Class="MAUI_Assignment.Components.ListItemView"
             x:DataType="models:ActivityItem">

    <Grid ColumnDefinitions="64,36,*" ColumnSpacing="10" Padding="0,12">
        <!-- Time -->
        <Label Grid.Column="0"
               Text="{Binding TimeAgo}"
               FontSize="10"
               TextColor="{StaticResource TextMuted}"
               VerticalOptions="Center" />

        <!-- Icon bubble -->
        <Border Grid.Column="1"
                WidthRequest="32" HeightRequest="32"
                StrokeThickness="0"
                BackgroundColor="{Binding IconBackground}"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Label Text="{Binding Icon}"
                   FontSize="13"
                   TextColor="{StaticResource White}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>

        <!-- Text -->
        <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
            <Label Text="{Binding Title}"
                   FontFamily="OpenSansSemibold"
                   FontSize="13"
                   TextColor="{StaticResource TextPrimary}" />
            <Label FontSize="11">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Author}"
                              FontFamily="OpenSansSemibold"
                              TextColor="{StaticResource TextPrimary}" />
                        <Span Text=" " />
                        <Span Text="{Binding Detail}"
                              TextColor="{StaticResource TextSecondary}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </VerticalStackLayout>
    </Grid>

</ContentView>
