<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_Assignment.Models"
             xmlns:vm="clr-namespace:MAUI_Assignment.ViewModels"
             xmlns:local="clr-namespace:MAUI_Assignment.Components"
             x:Class="MAUI_Assignment.Components.HeaderView"
             x:Name="Root"
             x:DataType="vm:DashboardViewModel">

    <Border Style="{StaticResource Card}" Padding="0">
        <Grid RowDefinitions="Auto,Auto">

            <!-- Top region: left summary + chart (wraps on narrow cards) -->
            <FlexLayout Grid.Row="0" Padding="22" Wrap="Wrap" Direction="Row" AlignItems="Start">

                <!-- Left column -->
                <VerticalStackLayout Spacing="16"
                                     FlexLayout.Grow="1" FlexLayout.Shrink="0"
                                     FlexLayout.Basis="200"
                                     MinimumWidthRequest="200">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Dashboard" Style="{StaticResource SectionTitle}" />
                        <Label Text="Overview of Latest Month" Style="{StaticResource SectionSubtitle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="1">
                        <Label Text="{Binding CurrentMonthEarnings}" Style="{StaticResource H1}" />
                        <Label Text="Current Month Earnings" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="1">
                        <Label Text="{Binding CurrentMonthSales}"
                               FontFamily="OpenSansSemibold" FontSize="24"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Current Month Sales" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>

                    <Button Text="Last Month Summary"
                            Style="{StaticResource AccentButton}"
                            HorizontalOptions="Start"
                            Command="{Binding LastMonthSummaryCommand}" />
                </VerticalStackLayout>

                <!-- Right column: tabs + chart -->
                <Grid RowDefinitions="Auto,*" RowSpacing="14"
                      FlexLayout.Grow="1" FlexLayout.Shrink="1"
                      FlexLayout.Basis="300"
                      MinimumWidthRequest="260"
                      Margin="0,10,0,0">
                    <!-- Tabs + legend wrap so the legend drops below on narrow widths -->
                    <FlexLayout Grid.Row="0" Wrap="Wrap" Direction="Row"
                                JustifyContent="SpaceBetween" AlignItems="Center">
                        <HorizontalStackLayout Spacing="20" Margin="0,0,0,6">
                            <Label Text="DAILY" Style="{StaticResource TabActive}" />
                            <Label Text="WEEKLY" Style="{StaticResource TabInactive}" />
                            <Label Text="MONTHLY" Style="{StaticResource TabInactive}" />
                            <Label Text="YEARLY" Style="{StaticResource TabInactive}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="16" Margin="0,0,0,6">
                            <HorizontalStackLayout Spacing="5">
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                         Color="{StaticResource ChartBlue}" VerticalOptions="Center" />
                                <Label Text="Online" Style="{StaticResource Caption}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="5">
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                         Color="{StaticResource ChartOrange}" VerticalOptions="Center" />
                                <Label Text="Store" Style="{StaticResource Caption}" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </FlexLayout>

                    <!-- Chart area placeholder: layered polygons -->
                    <Grid Grid.Row="1" HeightRequest="180">
                        <GraphicsView x:Name="ChartView" Drawable="{Binding Source={x:Reference Root}, Path=ChartDrawable, x:DataType=local:HeaderView}" />
                    </Grid>
                </Grid>
            </FlexLayout>

            <!-- Bottom summary stats -->
            <Border Grid.Row="1" StrokeThickness="1" Stroke="{StaticResource BorderColor}" BackgroundColor="Transparent" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Stretch" JustifyContent="Start"
                            BindableLayout.ItemsSource="{Binding SummaryStats}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:SummaryStat">
                            <Grid Padding="20,16" ColumnDefinitions="40,*" ColumnSpacing="12"
                                  FlexLayout.Grow="1"
                                  FlexLayout.Basis="{Binding Source={x:Reference Root}, Path=BindingContext.SummaryStatBasis}">
                                <Border Grid.Column="0" WidthRequest="34" HeightRequest="34"
                                        StrokeThickness="0" BackgroundColor="{Binding IconColor}"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="17" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Icon}" FontSize="14"
                                           TextColor="{StaticResource White}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Value}"
                                           FontFamily="OpenSansSemibold" FontSize="14"
                                           TextColor="{StaticResource TextPrimary}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </Border>
        </Grid>
    </Border>

</ContentView>
