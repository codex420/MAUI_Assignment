<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_Assignment.Models"
             xmlns:vm="clr-namespace:MAUI_Assignment.ViewModels"
             xmlns:local="clr-namespace:MAUI_Assignment.Components"
             x:Class="MAUI_Assignment.Components.HeaderView"
             x:Name="Root"
             x:DataType="vm:DashboardViewModel">

    <Border Style="{StaticResource Card}" Padding="0">
        <Grid RowDefinitions="*,Auto">

            <!-- ============ TOP REGION FOR DESKTOP / TABLET (Side-by-Side Grid) ============ -->
            <!-- Visible only when NOT compact (IsCompact = False). This ensures the chart shows up properly on desktop full screen. -->
            <Grid Grid.Row="0" Padding="22" ColumnDefinitions="Auto,*" ColumnSpacing="30"
                  IsVisible="{Binding IsCompact, Converter={StaticResource InvertBoolConverter}}">
                
                <!-- Left column: Summary Info -->
                <VerticalStackLayout Grid.Column="0" Spacing="16" WidthRequest="200" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Dashboard" Style="{StaticResource SectionTitle}" />
                        <Label Text="Overview of Latest Month" Style="{StaticResource SectionSubtitle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="1">
                        <Label Text="{Binding CurrentMonthEarnings}" Style="{StaticResource H1}" />
                        <Label Text="Current Month Earnings" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="1">
                        <Label Text="{Binding CurrentMonthSales}"
                               FontFamily="OpenSansSemibold" FontSize="24"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Current Month Sales" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>

                    <Button Text="Last Month Summary"
                            Style="{StaticResource AccentButton}"
                            HorizontalOptions="Start"
                            Command="{Binding LastMonthSummaryCommand}" />
                </VerticalStackLayout>

                <!-- Right column: Interactive Tabs + GraphicsView Chart -->
                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="14" Margin="0,10,0,0">
                    <!-- Tabs + Legend Row -->
                    <FlexLayout Grid.Row="0" Wrap="Wrap" Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center">
                        
                        <!-- Interactive Tabs -->
                        <HorizontalStackLayout Spacing="20" Margin="0,0,0,6">
                            <!-- DAILY Tab -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="DAILY" Style="{StaticResource TabInactive}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding ActiveChartTab}" Value="Daily">
                                            <Setter Property="Style" Value="{StaticResource TabActive}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <BoxView HeightRequest="2.5" Color="{StaticResource Accent}" IsVisible="False">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding ActiveChartTab}" Value="Daily">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChangeChartTabCommand}" CommandParameter="Daily" />
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>

                            <!-- WEEKLY Tab -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="WEEKLY" Style="{StaticResource TabInactive}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding ActiveChartTab}" Value="Weekly">
                                            <Setter Property="Style" Value="{StaticResource TabActive}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <BoxView HeightRequest="2.5" Color="{StaticResource Accent}" IsVisible="False">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding ActiveChartTab}" Value="Weekly">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChangeChartTabCommand}" CommandParameter="Weekly" />
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>

                            <!-- MONTHLY Tab -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="MONTHLY" Style="{StaticResource TabInactive}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding ActiveChartTab}" Value="Monthly">
                                            <Setter Property="Style" Value="{StaticResource TabActive}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <BoxView HeightRequest="2.5" Color="{StaticResource Accent}" IsVisible="False">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding ActiveChartTab}" Value="Monthly">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChangeChartTabCommand}" CommandParameter="Monthly" />
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>

                            <!-- YEARLY Tab -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="YEARLY" Style="{StaticResource TabInactive}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding ActiveChartTab}" Value="Yearly">
                                            <Setter Property="Style" Value="{StaticResource TabActive}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <BoxView HeightRequest="2.5" Color="{StaticResource Accent}" IsVisible="False">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding ActiveChartTab}" Value="Yearly">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChangeChartTabCommand}" CommandParameter="Yearly" />
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Legend -->
                        <HorizontalStackLayout Spacing="16" Margin="0,0,0,6">
                            <HorizontalStackLayout Spacing="5">
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                         Color="{StaticResource ChartBlue}" VerticalOptions="Center" />
                                <Label Text="Online" Style="{StaticResource Caption}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="5">
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                         Color="{StaticResource ChartOrange}" VerticalOptions="Center" />
                                <Label Text="Store" Style="{StaticResource Caption}" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </FlexLayout>

                    <!-- Chart Canvas -->
                    <Grid Grid.Row="1" HeightRequest="180">
                        <GraphicsView x:Name="ChartView" Drawable="{Binding Source={x:Reference Root}, Path=ChartDrawable, x:DataType=local:HeaderView}" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- ============ TOP REGION FOR MOBILE / COMPACT (Stacked Grid) ============ -->
            <!-- Visible only when compact (IsCompact = True). This places the chart below the summary column cleanly. -->
            <Grid Grid.Row="0" Padding="22" RowDefinitions="Auto,Auto" RowSpacing="20"
                  IsVisible="{Binding IsCompact}">
                
                <!-- Summary Info -->
                <VerticalStackLayout Grid.Row="0" Spacing="16">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Dashboard" Style="{StaticResource SectionTitle}" />
                        <Label Text="Overview of Latest Month" Style="{StaticResource SectionSubtitle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="1">
                        <Label Text="{Binding CurrentMonthEarnings}" Style="{StaticResource H1}" />
                        <Label Text="Current Month Earnings" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="1">
                        <Label Text="{Binding CurrentMonthSales}"
                               FontFamily="OpenSansSemibold" FontSize="24"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Current Month Sales" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>

                    <Button Text="Last Month Summary"
                            Style="{StaticResource AccentButton}"
                            HorizontalOptions="Start"
                            Command="{Binding LastMonthSummaryCommand}" />
                </VerticalStackLayout>

                <!-- Tabs + Chart -->
                <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="14" Margin="0,10,0,0">
                    <!-- Tabs + Legend Row -->
                    <FlexLayout Grid.Row="0" Wrap="Wrap" Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center">
                        
                        <!-- Interactive Tabs -->
                        <HorizontalStackLayout Spacing="20" Margin="0,0,0,6">
                            <!-- DAILY Tab -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="DAILY" Style="{StaticResource TabInactive}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding ActiveChartTab}" Value="Daily">
                                            <Setter Property="Style" Value="{StaticResource TabActive}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <BoxView HeightRequest="2.5" Color="{StaticResource Accent}" IsVisible="False">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding ActiveChartTab}" Value="Daily">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChangeChartTabCommand}" CommandParameter="Daily" />
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>

                            <!-- WEEKLY Tab -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="WEEKLY" Style="{StaticResource TabInactive}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding ActiveChartTab}" Value="Weekly">
                                            <Setter Property="Style" Value="{StaticResource TabActive}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <BoxView HeightRequest="2.5" Color="{StaticResource Accent}" IsVisible="False">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding ActiveChartTab}" Value="Weekly">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChangeChartTabCommand}" CommandParameter="Weekly" />
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>

                            <!-- MONTHLY Tab -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="MONTHLY" Style="{StaticResource TabInactive}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding ActiveChartTab}" Value="Monthly">
                                            <Setter Property="Style" Value="{StaticResource TabActive}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <BoxView HeightRequest="2.5" Color="{StaticResource Accent}" IsVisible="False">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding ActiveChartTab}" Value="Monthly">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChangeChartTabCommand}" CommandParameter="Monthly" />
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>

                            <!-- YEARLY Tab -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="YEARLY" Style="{StaticResource TabInactive}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding ActiveChartTab}" Value="Yearly">
                                            <Setter Property="Style" Value="{StaticResource TabActive}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <BoxView HeightRequest="2.5" Color="{StaticResource Accent}" IsVisible="False">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding ActiveChartTab}" Value="Yearly">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChangeChartTabCommand}" CommandParameter="Yearly" />
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Legend -->
                        <HorizontalStackLayout Spacing="16" Margin="0,0,0,6">
                            <HorizontalStackLayout Spacing="5">
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                         Color="{StaticResource ChartBlue}" VerticalOptions="Center" />
                                <Label Text="Online" Style="{StaticResource Caption}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="5">
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                         Color="{StaticResource ChartOrange}" VerticalOptions="Center" />
                                <Label Text="Store" Style="{StaticResource Caption}" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </FlexLayout>

                    <!-- Chart Canvas (Compact) -->
                    <Grid Grid.Row="1" HeightRequest="180">
                        <GraphicsView x:Name="ChartViewCompact" Drawable="{Binding Source={x:Reference Root}, Path=ChartDrawable, x:DataType=local:HeaderView}" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- ============ BOTTOM REGION (Sized using HeightRequest to prevent clipping) ============ -->
            <Border Grid.Row="1" StrokeThickness="1" Stroke="{StaticResource BorderColor}" BackgroundColor="Transparent" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Stretch" JustifyContent="Start"
                            BindableLayout.ItemsSource="{Binding SummaryStats}"
                            HeightRequest="{Binding HeaderBottomHeight}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:SummaryStat">
                            <Grid Padding="20,16" ColumnDefinitions="40,*" ColumnSpacing="12"
                                  FlexLayout.Grow="1"
                                  FlexLayout.Basis="{Binding Source={x:Reference Root}, Path=BindingContext.SummaryStatBasis}">
                                <Border Grid.Column="0" WidthRequest="34" HeightRequest="34"
                                        StrokeThickness="0" BackgroundColor="{Binding IconColor}"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="17" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Icon}" FontSize="14"
                                           TextColor="{StaticResource White}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Value}"
                                           FontFamily="OpenSansSemibold" FontSize="14"
                                           TextColor="{StaticResource TextPrimary}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </Border>
        </Grid>
    </Border>

</ContentView>
